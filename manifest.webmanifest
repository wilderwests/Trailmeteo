{
  "name": "TrailMeteo · Montaña, con perspectiva",
  "short_name": "TrailMeteo",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#eef1ef",
  "theme_color": "#f3f5f6",
  "description": "Planificador de rutas de montaña: tiempo tramo a tramo, decisión GO/OJO/STOP, AEMET, DGT, canales de Picos y copiloto IA.",
  "lang": "es",
  "categories": ["weather", "sports", "travel", "navigation"],
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Planificar una ruta", "url": "./#route", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Canales de Picos", "url": "./#canales", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Radar", "url": "./#radar", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "url": "url", "files": [{"name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream"]}]}
  },
  "file_handlers": [
    {"action": "./", "accept": {"application/gpx+xml": [".gpx"]}}
  ],
  "id": "./",
  "scope": "./"
}
